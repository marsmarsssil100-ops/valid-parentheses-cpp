#include <iostream>
#include <stack>
#include <string>

using namespace std;

class Solution {
public:
    bool isValid(string s) {
        stack<char> t;
        
        for (char c : s) {
            if (c == '(' || c == '[' || c == '{') {
                t.push(c);
            } else {
                if (t.empty()) {
                    return false;
                }
                
                char top = t.top();
                
                if ((c == ')' && top == '(') ||
                    (c == ']' && top == '[') ||
                    (c == '}' && top == '{')) {
                    t.pop();
                } else {
                    return false;
                }
            }
        }
        
        return t.empty();
    }
};
